{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug index.html (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "file": "${workspaceFolder}/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Debug localhost:5500 (Chrome)",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:5500/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Debug current file (Node.js)",
      "type": "pwa-node",
      "request": "launch",
      "program": "${file}"
    }
  ]
}
